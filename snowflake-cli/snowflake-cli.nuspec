<?xml version="1.0"?>
<package>
  <metadata>
    <id>snowflake-cli</id>
    <version>x.y.z</version>
    <title>Snowflake CLI</title>
    <authors>Slavo Nagy</authors>
    <description>Snowflake's command-line interface.</description>
    <summary>Snowflake's command line interface includes all commands for managing your Snowflake account objects</summary>
    <projectUrl>https://github.com/snowflakedb/snowflake-cli</projectUrl>
    <licenseUrl>https://github.com/snowflakedb/snowflake-cli/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>snowflake cli</tags>
    <iconUrl>https://cdn.jsdelivr.net/gh/glincker/thesvg@main/public/icons/snowflake/default.svg</iconUrl>
    <packageSourceUrl>https://sfc-repo.snowflakecomputing.com/snowflake-cli/windows_x86_64/x.y.z/snowflake-cli-x.y.z.0-x86_64.msi</packageSourceUrl>
    <releaseNotes>https://docs.snowflake.com/en/release-notes/clients-drivers/snowflake-cli</releaseNotes>
    <dependencies>
      <dependency id="python3" version="3.13.16" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**\*.py" target="tools" />
  </files>
</package>
