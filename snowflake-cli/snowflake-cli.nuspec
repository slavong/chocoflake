<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd"></package>
  <metadata>
    <id>snowflake-cli</id>
    <version>x.y.z</version>
    <title>Snowflake CLI</title>
    <authors>Snowflake Inc.</authors>
    <description>Snowflake's command-line interface is a unified command-line tool that enables developers to build, test, and deploy applications on Snowflake. It provides seamless integration with Snowflake features such as Snowpark, native apps, stored procedures, and programmatic interaction with your data warehouse directly from your local terminal or CI/CD pipelines.
Features:
- Snowpark Development: Easily build, package, and deploy Python, Java, and Scala code (functions and procedures) directly to Snowflake.
- Native Apps: Initialize, build, and deploy Snowflake Native Apps locally.
- Streamlined Workflow: Manage database objects, execute SQL queries, and monitor deployments without leaving your command line.
- Extensible and Fast: Built for modern data engineering and development workflows.
License: This package and the underlying software are made available under the terms of the Apache License 2.0.
Notes:
- This package installs the official Snowflake CLI binary.
- Requires Python (refer to official Snowflake documentation for specific version compatibility).</description>
    <summary>Snowflake CLI (snowflake-cli) is an open-source command-line tool that simplifies building, testing, and deploying Snowpark applications, Native Apps, and SQL workloads directly from your terminal or CI/CD pipelines.</summary>
    <projectUrl>https://docs.snowflake.com/en/developer-guide/snowflake-cli/index</projectUrl>
    <licenseUrl>https://github.com/snowflakedb/snowflake-cli/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>snowflake cli</tags>
    <projectSourceUrl>https://github.com/snowflakedb/snowflake-cli</projectSourceUrl>
    <docsUrl>https://docs.snowflake.com/en/developer-guide/snowflake-cli/command-reference/overview</docsUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/slavong/chocoflake@logo/bug-sno-blue.png</iconUrl>
    <releaseNotes>https://docs.snowflake.com/en/release-notes/clients-drivers/snowflake-cli</releaseNotes>
    <packageSourceUrl>https://github.com/slavong/chocoflake</packageSourceUrl>
    <copyright>Copyright (c) Snowflake Inc.</copyright>
    <owners>Slavo Nagy</owners>
  </metadata>
</package>
